[Unit]
Description=PPT-SVG Next.js service
After=network.target

[Service]
Type=simple
WorkingDirectory=/dev/ppt-svg/PPT-SVG
Environment=NODE_ENV=production
Environment=NEXT_PUBLIC_BASE_PATH=/ppt
Environment=PATH=/root/.nvm/versions/node/v24.15.0/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
EnvironmentFile=-/dev/ppt-svg/PPT-SVG/.env.local
ExecStart=/root/.nvm/versions/node/v24.15.0/bin/npm run start -- --hostname 127.0.0.1 --port 3000
Restart=always
RestartSec=5

# --- Sandboxing (limits blast radius of any RCE, e.g. in image parsing) ---
# Best practice is to also run as a non-root user. That requires node to be
# reachable outside /root (e.g. install to /usr/local via nodesource, or move
# nvm to /opt), then add:
#   User=ppt-svg
#   Group=ppt-svg
#   ProtectHome=yes
# and relocate WorkingDirectory/EnvironmentFile out of /dev to /opt or /srv.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/dev/ppt-svg/PPT-SVG
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
