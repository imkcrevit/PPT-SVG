{
  "name": "ppt-svg",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "bash ./scripts/start.sh dev",
    "debug": "bash ./scripts/start.sh debug",
    "build": "NEXT_PUBLIC_BASE_PATH=${NEXT_PUBLIC_BASE_PATH-/ppt} next build",
    "start": "bash ./scripts/start.sh prod",
    "stop": "bash ./scripts/start.sh stop",
    "check:sessions": "node scripts/check-session-concurrency.mjs",
    "test:snapshots": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/snapshot-test.ts",
    "test:layout": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/diagram-layout-assertions.ts",
    "test:deck": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/deck-template.ts",
    "test:theme": "npm run test:theme:intent && npm run test:theme:image",
    "test:theme:intent": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/theme-intent.ts",
    "test:theme:image": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/theme-image-classifier.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:flow-wrap": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/flow-wrap.ts",
    "test:ui-selection": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/svg-pointer.ts",
    "test:mcp-routing": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/diagram-mcp.ts",
    "test:mcp": "node tests/mcp-server.mjs",
    "test:dsh": "node tests/dsh-bundle.mjs",
    "test:fallback": "node --experimental-strip-types --experimental-loader ./tests/ts-path-loader.mjs tests/generation-fallback.ts"
  },
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.0",
    "jszip": "^3.10.1",
    "lucide-react": "^1.16.0",
    "mongodb": "^7.2.0",
    "next": "^16.2.10",
    "pptxgenjs": "^3.12.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "sharp": "^0.34.5",
    "unpdf": "^1.6.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
