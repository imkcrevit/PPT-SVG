OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=PPT-SVG
# Set to 1 to send response_format:json_object. Off by default because some
# providers/models (e.g. GPT-5.6) reject it alongside max_completion_tokens.
OPENROUTER_JSON_MODE=
# Proxy — FOR A DEV/TEST MACHINE ONLY (e.g. behind a firewall that blocks
# direct egress to OpenRouter). LEAVE ALL THREE BLANK ON SERVERS: a server with
# direct internet must NOT set these, or node will try to reach a proxy that
# does not exist on that host and every LLM call will fail while uploads (which
# need no egress) keep working. These use Node's built-in env-proxy support.
#   NODE_USE_ENV_PROXY=1
#   HTTPS_PROXY=http://127.0.0.1:10808
#   HTTP_PROXY=http://127.0.0.1:10808
NODE_USE_ENV_PROXY=
HTTPS_PROXY=
HTTP_PROXY=
PPT_SVG_LLM_API_KEY=
PPT_SVG_LLM_MODEL=
PPT_SVG_LLM_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
MONGODB_URI=
MONGODB_DB=ppt_svg
